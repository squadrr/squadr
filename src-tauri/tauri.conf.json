{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squadr",
  "version": "0.2.5",
  "identifier": "com.squadr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Squadr",
        "width": 1180,
        "height": 720,
        "minWidth": 940,
        "minHeight": 580,
        "decorations": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBQzMxOTgwRjc3QUJGM0IKUldRN3YzcjNnQm5EU2hXS05CMGtzcFpNK1JTTjE3clR3L1lwOE9OVzJkR1h4eVI0QzMzeWZjb0YK",
      "endpoints": [
        "https://github.com/squadrr/squadr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}